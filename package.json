{
  "name": "@cboyke/demotools",
  "author": "Chris Boyke",
  "description": "Reusable React components for building commercetools demos",
  "version": "4.0.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "default": "./dist/chat/index.js"
    },
    "./chat/server": {
      "types": "./dist/chat/server/index.d.ts",
      "default": "./dist/chat/server/index.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "README.md"
  ],
  "type": "module",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercetools-demo/demotools.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/commercetools-demo/demotools/issues"
  },
  "homepage": "https://github.com/commercetools-demo/demotools#readme"
}
